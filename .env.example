# Copy to .env and fill in. .env is gitignored and must never be committed.
# Values here OVERRIDE your shell environment — see app/config.py.
#
# With a key set, drafts and triage escalation call the live API.
# With none, the app runs in replay mode against recorded fixtures — the full
# workflow still works, deterministically, with no credential.
#
# Left commented on purpose: copying this file must never blank out a key you
# already have exported. Uncomment only when you are putting a real key here.
# ANTHROPIC_API_KEY=sk-ant-...

# Model tiering — see DECISIONS.md D-17.
SIDESTAGE_DRAFT_MODEL=claude-sonnet-5
SIDESTAGE_TRIAGE_MODEL=claude-haiku-4-5

# "live" | "replay" | "auto"  (auto = live when a key is present)
SIDESTAGE_LLM_MODE=auto
